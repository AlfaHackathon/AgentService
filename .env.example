DATABASE_URL=postgresql://agent:local-development-only@localhost:5432/agent_service
DATABASE_POOL_MAX=10
PORT=3000

# OpenAI-compatible Chat Completions endpoint. Include /v1 if the provider needs it.
LLM_BASE_URL=https://llm.example.com/v1
LLM_API_KEY=replace-with-provider-key
LLM_MODEL=replace-with-provider-model-id
LLM_CONTEXT_WINDOW=128000
LLM_MAX_TOKENS=8192
LLM_REASONING=false

# Local compose database only.
POSTGRES_PASSWORD=local-development-only
# Optional command-line chat client:
# AGENT_SERVICE_URL=http://localhost/agent-service
# AGENT_SERVICE_TOKEN=existing-user-token-for-the-gateway
# Direct local dev only (when bypassing the gateway):
# AGENT_SERVICE_URL=http://localhost:5173/agent-service
# AGENT_SERVICE_USER_ID=11111111-1111-4111-8111-111111111111

# Optional public origin when TLS terminates at a reverse proxy.
# PUBLIC_ORIGIN=https://api.cheremha.ru

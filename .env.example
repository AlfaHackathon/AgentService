DATABASE_URL=postgresql://agent:local-development-only@localhost:5432/agent_service
DATABASE_POOL_MAX=10
PORT=3000

# OpenAI-compatible Chat Completions endpoint. Include /v1 if the provider needs it.
LLM_BASE_URL=https://llm.example.com/v1
LLM_API_KEY=replace-with-provider-key
LLM_MODEL=replace-with-provider-model-id
LLM_CONTEXT_WINDOW=128000
LLM_MAX_TOKENS=8192
LLM_REASONING=false

# Optional internal news-analysis integration. Empty/missing settings disable only
# this route with 503; existing chats keep working. Do not expose it publicly.
INTERNAL_SECRET=
COMPANY_SERVICE_URL=http://127.0.0.1:8081/company-service
CONTEXT_SERVICE_URL=http://127.0.0.1:5181/context-service
INSIGHT_SERVICE_URL=http://127.0.0.1:5182/insight-service
# Optional existing news-parser-service base URL, including its route prefix.
# Currently supports stored/TASS lead search only; no full-original/version API.
# NEWS_SERVICE_URL=http://127.0.0.1:8086/news-parser-service
# Kafka consumer of the existing NewsEventMessage. Enable on each worker instance
# using the SAME group id; offsets are committed after durable job admission.
NEWS_KAFKA_ENABLED=false
KAFKA_BROKERS=localhost:9092
NEWS_KAFKA_TOPIC=news-parser.news
NEWS_KAFKA_GROUP_ID=agent-service-news-v1
NEWS_KAFKA_FROM_BEGINNING=true
KAFKA_SSL=false
# Optional: KAFKA_SASL_MECHANISM=plain|scram-sha-256|scram-sha-512
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=
# Optional local phase traces (source texts/results, provider token usage and latency).
# NEWS_TRACE_DIRECTORY=.test-data/news-traces

# Local compose database only.
POSTGRES_PASSWORD=local-development-only
# Optional command-line chat client:
# AGENT_SERVICE_URL=http://localhost/agent-service
# AGENT_SERVICE_TOKEN=existing-user-token-for-the-gateway
# Direct local dev only (when bypassing the gateway):
# AGENT_SERVICE_URL=http://localhost:5173/agent-service
# AGENT_SERVICE_USER_ID=11111111-1111-4111-8111-111111111111

# Optional public origin when TLS terminates at a reverse proxy.
# PUBLIC_ORIGIN=https://api.cheremha.ru
